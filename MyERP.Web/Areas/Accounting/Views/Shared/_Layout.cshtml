<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@ViewData["Title"] - المنصة الرقمية</title>
    <!-- 1. SEO Meta Tags -->
    <meta name="description" content="المنصة الرقمية الموحدة لمحافظة كفر الشيخ - نظام ERP شامل لإدارة الموارد البشرية، المخازن، الشئون القانونية، والحملة">
    <meta name="keywords" content="ERP, كفر الشيخ, موارد بشرية, مخازن, حكومة الكترونية, تحول رقمي">
    <meta name="author" content="الإدارة العامة لنظم المعلومات والتحول الرقمي">
    <!-- Bootstrap -->
    <link rel="stylesheet" href="~/css/bootstrap/bootstrap.min.css">
    <!-- Font Awesome -->
    <link rel="stylesheet" href="~/css/all.min.css">
    <!-- animate -->
    <link rel="stylesheet" href="~/css/animate/animate.css">
    <!-- Global Css Link -->
    <link rel="stylesheet" href="~/css/global/main.css">
    <!-- Theme style -->
    <link rel="stylesheet" href="~/css/global/adminlte.css">
    <!-- dash-style -->
    <link rel="stylesheet" href="~/css/global/dash-style.css">
    <!-- Modern Luxe Custom Styles -->
    <style>
        .main-sidebar { top: 62px !important; height: calc(100vh - 62px) !important; position: fixed !important; background: #0f172a !important; border-left: 1px solid rgba(255,255,255,0.05); }
        .content-wrapper { margin-top: 0 !important; }
        .sidebar { height: calc(100% - 10px) !important; overflow-y: auto; p-0; }
        .btn-login-style:hover { background: #3b82f6 !important; color: #fff !important; box-shadow: 0 0 15px rgba(59, 130, 246, 0.4); }
        .search-permanent input::placeholder { color: rgba(255,255,255,0.3); }
    </style>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cairo:wght@300;400;500;600;700;800;900&display=swap">
</head>
<body class="hold-transition sidebar-mini layout-fixed" style="margin:0;">
    <!-- Modern Integrated Navbar -->
    <nav class="navbar sticky-top shadow-sm" style="background: #0f172a !important; border-bottom: 1px solid rgba(255,255,255,0.1); font-family: 'Cairo', sans-serif; padding: 0.5rem 0 0.8rem 0; height: 62px; z-index: 1040;">
        <div class="container-fluid px-4 d-flex align-items-center justify-content-between">
            <!-- Right side (RTL): Menu Toggle & Logo -->
            <div class="d-flex align-items-center gap-3">
                <a class="nav-link text-white p-2 hover-bg-white-10 rounded-3" data-widget="pushmenu" href="#" role="button" title="فتح القائمة الجانبية">
                    <i class="fas fa-bars" style="font-size: 1.25rem;"></i>
                </a>
                <div class="navbar-brand d-flex align-items-center ms-2 m-0" style="cursor: default;">
                    <img src="~/imgs/kfslogo.jpg" style="height: 40px; border-radius: 6px; box-shadow: 0 4px 10px rgba(0,0,0,0.3);" alt="KFS Logo">
                    <div class="d-flex flex-column me-3 d-none d-md-flex" style="gap: 0.3rem;">
                        <span style="color: #fff; font-weight: 800; font-size: 1.15rem; line-height: 1;">الحسابات العامة</span>
                        <small style="color: rgba(255,255,255,0.6); font-size: 0.75rem; letter-spacing: 0.5px;">محافظة كفر الشيخ</small>
                    </div>
                </div>
            </div>
            <!-- Left side: Utilities & Navigation -->
            <div class="d-flex align-items-center gap-2">
                <div class="search-permanent d-none d-lg-block" style="width: 320px;">
                    <div class="input-group overflow-hidden shadow-sm d-flex flex-row-reverse" style="background: rgba(255,255,255,0.05); border-radius: 50px; border: 1px solid rgba(255,255,255,0.1); padding: 2px 15px;">
                        <span class="input-group-text border-0 bg-transparent p-0 d-flex align-items-center"><i class="fas fa-search text-white opacity-40" style="font-size: 0.9rem;"></i></span>
                        <input class="form-control border-0 bg-transparent text-white me-2 text-start" type="search" placeholder="بحث سريع..." style="font-family: 'Cairo', sans-serif; font-size: 0.85rem; height: 34px; box-shadow: none !important; direction: ltr;">
                    </div>
                </div>
                <a class="nav-link text-white opacity-50 hover-opacity-100 p-0 d-none d-sm-block ms-2" data-widget="fullscreen" href="#" role="button" title="تكبير الشاشة"><i class="fas fa-expand-arrows-alt" style="font-size: 1.1rem;"></i></a>
                <a asp-area="" asp-controller="Home" asp-action="Index" class="btn btn-login-style ms-2 d-flex align-items-center gap-2 px-3 py-1.5" style="background: transparent; border: 1px solid #3b82f6; border-radius: 10px; color: #3b82f6; font-size: 0.9rem; font-weight: 700; transition: all 0.3s ease;">
                    <i class="fa-solid fa-house-chimney-window"></i>
                    <span>الرئيسية</span>
                </a>
            </div>
        </div>
    </nav>
    <div class="wrapper">
        <!-- Main Sidebar Container -->
        <aside class="main-sidebar sidebar-dark-primary elevation-4 bg-dark">
            <!-- Sidebar -->
            <div class="sidebar p-0">

                <!-- Sidebar right Menu -->
                <nav class="mt-2">
                    <ul class="nav nav-pills nav-sidebar flex-column" data-widget="treeview" role="menu" data-accordion="false">
                        <!-- 1. الرئيسية (Dashboard) -->
                        <li class="nav-item">
                            <a asp-area="Accounting" asp-controller="Home" asp-action="Index" class="nav-link active">
                                <i class="nav-icon fas fa-tachometer-alt"></i>
                                <p>لوحة الإحصائيات</p>
                            </a>
                        </li>

                        <!-- 2. العمليات اليومية (القلب النابض للحسابات) -->
                        <li class="nav-item">
                            <a href="#" class="nav-link">
                                <i class="nav-icon fas fa-file-invoice-dollar"></i>
                                <p>
                                    العمليات والقيود
                                    <i class="fas fa-angle-left right"></i>
                                </p>
                            </a>
                            <ul class="nav nav-treeview">
                                <li class="nav-item">
                                    <!-- صفحة القيود اليومية -->
                                    <a asp-area="Accounting" asp-controller="JournalEntry" asp-action="Index" class="nav-link">
                                        <i class="far fa-circle nav-icon text-info"></i>
                                        <p>قيود اليومية</p>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <!-- صفحة سندات الصرف -->
                                    <a asp-area="Accounting" asp-controller="Vouchers" asp-action="Payment" class="nav-link">
                                        <i class="far fa-circle nav-icon text-danger"></i>
                                        <p>سندات الصرف النقدية</p>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <!-- صفحة سندات القبض -->
                                    <a asp-area="Accounting" asp-controller="Vouchers" asp-action="Receipt" class="nav-link">
                                        <i class="far fa-circle nav-icon text-success"></i>
                                        <p>سندات القبض</p>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <!-- الترحيل للحسابات -->
                                    <a asp-area="Accounting" asp-controller="Posting" asp-action="Index" class="nav-link">
                                        <i class="far fa-circle nav-icon text-warning"></i>
                                        <p>ترحيل القيود</p>
                                    </a>
                                </li>
                            </ul>
                        </li>

                        <!-- 3. دليل الحسابات والتجهيز -->
                        <li class="nav-item">
                            <a href="#" class="nav-link">
                                <i class="nav-icon fas fa-book"></i>
                                <p>
                                    الدليل والتعريفات
                                    <i class="fas fa-angle-left right"></i>
                                </p>
                            </a>
                            <ul class="nav nav-treeview">
                                <li class="nav-item">
                                    <!-- شجرة الحسابات -->
                                    <a asp-area="Accounting" asp-controller="ChartOfAccounts" asp-action="Index" class="nav-link">
                                        <i class="far fa-dot-circle nav-icon"></i>
                                        <p>دليل الحسابات (COA)</p>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <!-- مراكز التكلفة -->
                                    <a asp-area="Accounting" asp-controller="CostCenters" asp-action="Index" class="nav-link">
                                        <i class="far fa-dot-circle nav-icon"></i>
                                        <p>مراكز التكلفة</p>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a asp-area="Accounting" asp-controller="Banks" asp-action="Index" class="nav-link">
                                        <i class="far fa-dot-circle nav-icon"></i>
                                        <p>تعريف البنوك والخزائن</p>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a asp-area="Accounting" asp-controller="Currencies" asp-action="Index" class="nav-link">
                                        <i class="far fa-dot-circle nav-icon"></i>
                                        <p>العملات وأسعار الصرف</p>
                                    </a>
                                </li>
                            </ul>
                        </li>

                        <!-- 4. العملاء والموردين (Auxiliary) -->
                        <li class="nav-item">
                            <a href="#" class="nav-link">
                                <i class="nav-icon fas fa-users-cog"></i>
                                <p>
                                    شركاء النجاح
                                    <i class="right fas fa-angle-left"></i>
                                </p>
                            </a>
                            <ul class="nav nav-treeview">
                                <li class="nav-item">
                                    <a asp-area="Accounting" asp-controller="Customers" asp-action="Index" class="nav-link">
                                        <i class="nav-icon fas fa-user-tag"></i>
                                        <p>العملاء وأرصدتهم</p>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a asp-area="Accounting" asp-controller="Suppliers" asp-action="Index" class="nav-link">
                                        <i class="nav-icon fas fa-truck-loading"></i>
                                        <p>الموردين والمستحقات</p>
                                    </a>
                                </li>
                            </ul>
                        </li>

                        <!-- 5. التقارير المالية (Financial Reports) -->
                        <li class="nav-header">التقارير المالية</li>

                        <li class="nav-item">
                            <a asp-area="Accounting" asp-controller="Reports" asp-action="Ledger" class="nav-link">
                                <i class="nav-icon fas fa-list-alt"></i>
                                <p>كشف حساب (أستاذ مساعد)</p>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a asp-area="Accounting" asp-controller="Reports" asp-action="TrialBalance" class="nav-link">
                                <i class="nav-icon fas fa-balance-scale"></i>
                                <p>ميزان المراجعة</p>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a href="#" class="nav-link">
                                <i class="nav-icon fas fa-chart-line"></i>
                                <p>
                                    الحسابات الختامية
                                    <i class="fas fa-angle-left right"></i>
                                </p>
                            </a>
                            <ul class="nav nav-treeview">
                                <li class="nav-item">
                                    <a asp-area="Accounting" asp-controller="Reports" asp-action="IncomeStatement" class="nav-link">
                                        <i class="far fa-circle nav-icon"></i>
                                        <p>قائمة الدخل (أرباح وخسائر)</p>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a asp-area="Accounting" asp-controller="Reports" asp-action="BalanceSheet" class="nav-link">
                                        <i class="far fa-circle nav-icon"></i>
                                        <p>الميزانية العمومية</p>
                                    </a>
                                </li>
                            </ul>
                        </li>

                        <!-- 6. الإعدادات -->
                        <li class="nav-header">إعدادات النظام</li>
                        <li class="nav-item">
                            <a asp-area="Accounting" asp-controller="FiscalYears" asp-action="Index" class="nav-link">
                                <i class="nav-icon fas fa-calendar-alt"></i>
                                <p>السنوات المالية</p>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a asp-area="Accounting" asp-controller="Settings" asp-action="Index" class="nav-link">
                                <i class="nav-icon fas fa-cogs"></i>
                                <p>إعدادات الحسابات العامة</p>
                            </a>
                        </li>
                    </ul>
                </nav>
                <!-- /  Sidebar right Menu -->
            </div>
            <!-- /.sidebar -->
        </aside>
        <!-- Main Sidebar Container -->

        <div class="content-wrapper">
            @RenderBody()
        </div>
        <!-- Start Footer (Modern Style) -->
        <footer style="background: #0f172a !important; border-top: 1px solid rgba(255,255,255,0.1) !important; padding: 1.5rem 0 !important; font-family: 'Cairo', sans-serif !important; height: auto !important; min-height: 60px !important; display: block !important;">
            <div class="container-fluid text-center">
                <p style="color: #fff !important; margin: 0 !important; font-size: 0.9rem !important; font-weight: 500 !important; opacity: 0.85 !important; line-height: 1.8 !important; padding: 0 1.5rem !important; word-wrap: break-word !important; white-space: normal !important;">
                    حقوق الطبع والنشر &copy; الإدارة العامة لنظم المعلومات والتحول الرقمي <a href="#" style="color: #3b82f6 !important; font-weight: 700 !important; text-decoration: none !important; display: inline-block !important;">إدارة النظم والتطبيقات</a>.
                </p>
            </div>
        </footer>
        <!-- End Footer -->
        <!-- jQuery -->
        <script src="js/jquery/jquery.min.js"></script>
        <!-- Bootstrap -->
        <script src="js/bootstrap/bootstrap.bundle.min.js"></script>
        <!-- Font Awesome  -->
        <script src="js/all.min.js"></script>
        <!-- AdminLTE App -->
        <script src="js/global/adminlte.js"></script>
        <!-- global js -->
        <script src="js/global/main.js"></script>

        <script src="js/animate/wow.min.js"></script>
        <script>
            new WOW().init();
        </script>
        <script>
            $(function () {
                $('.select2').select2()
            });
        </script>
</body>
</html>