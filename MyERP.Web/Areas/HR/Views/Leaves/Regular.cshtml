                            <td class="fw-bold">1016</td>
                            <td class="fw-bold">رانيا أبو النصر</td>
                            <td>عارضة</td>
                            <td>10/05/2024</td>
                            <td>11/05/2024</td>
                            <td>2 يوم</td>
                            <td>فاطمة الشرباني</td>
                            <td>قيد الموافقة</td>
                            <td>
                                <button class="hr-action-btn" title="تعديل">
                                    <i class="fas fa-edit"></i>
                                </button>
                            </td>
                        </tr>
                        <tr>
                            <td class="fw-bold">1017</td>
                            <td class="fw-bold">بهجت إبراهيم</td>
                            <td>اعتيادي</td>
                            <td>20/05/2024</td>
                            <td>25/05/2024</td>
