</div>

<!-- Soft Modal -->
<div class="modal fade" id="leaveModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content soft-modal">
            <form method="post" asp-action="CreateRegularRequest">
                <div class="modal-header soft-modal-header w-100">
                    <h5 class="modal-title m-0 fw-bold" style="color: var(--soft-text-main);">
                        تقديم طلب أجازة
                    </h5>
                    <button type="button" class="btn-close m-0" data-bs-dismiss="modal" aria-label="Close" style="box-shadow:none;"></button>
                </div>

                <div class="modal-body soft-modal-body">
                    <div class="row g-4">
                        <div class="col-md-12">
                            <label class="soft-label">نوع الأجازة</label>
                            <div class="soft-radio-group">
                                <label class="soft-radio-item">
                                    <input type="radio" name="LeaveType" value="Regular" checked>
                                    <span>أجازة اعتيادية</span>
                                </label>
                                <label class="soft-radio-item">
                                    <input type="radio" name="LeaveType" value="Casual">
                                    <span>أجازة عارضة</span>
                                </label>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <label class="soft-label">الموظف مقدم الطلب</label>
                            <select class="form-select soft-input w-100">
                                <option>محمد فؤاد ابراهيم</option>
                                <option>فاطمة الشرباني</option>
                                <option>رانيا ابو النصر</option>
                            </select>
                        </div>
                        
                        <div class="col-md-6">
                            <label class="soft-label">القائم بالعمل بدلاً منه</label>
                            <select class="form-select soft-input w-100">
                                <option>-- اختر --</option>
                                <option>بهجت إبراهيم</option>
                                <option>أمنة جمعة</option>
                            </select>
                        </div>

                        <div class="col-md-4">
                            <label class="soft-label">تاريخ البداية</label>
                            <input type="date" class="form-control soft-input" id="startDate" onchange="calculateDays()">
                        </div>
                        <div class="col-md-4">
                            <label class="soft-label">تاريخ النهاية</label>
                            <input type="date" class="form-control soft-input" id="endDate" onchange="calculateDays()">
                        </div>
                        <div class="col-md-4">
                            <label class="soft-label">المدة المطلوبة</label>
                            <input type="text" class="form-control soft-input" id="daysCount" readonly value="0" style="background:#f1f5f9; cursor:not-allowed; text-align:center; font-weight:bold;">
                        </div>
                        
                        <div class="col-md-12">
                            <label class="soft-label">بيانات التواصل المتاحة أثناء الأجازة</label>
                            <input type="text" class="form-control soft-input" placeholder="اكتب رقم موبايل أو وسيلة تواصل...">
                        </div>
                    </div>
                </div>

                <div class="modal-footer soft-modal-footer d-flex justify-content-end gap-2">
                    <button type="button" class="soft-btn text-muted" data-bs-dismiss="modal" style="background:transparent;">إلغاء الأمر</button>
                    <button type="submit" class="soft-btn soft-btn-primary">
                        <i class="fas fa-check"></i> حفظ وإرسال
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Scripts -->
<script type="text/javascript" src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
<script type="text/javascript" src="https://cdn.datatables.net/buttons/2.4.2/js/dataTables.buttons.min.js"></script>
<script type="text/javascript" src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.html5.min.js"></script>

<script>
    $(document).ready(function() {
        $('select.select2').each(function() {
            var $this = $(this);
            var parent = $this.closest('.modal').length ? $this.closest('.modal') : $(document.body);
            $this.select2({
                theme: 'bootstrap4',
                dropdownParent: parent,
                dir: "rtl"
            });
        });

        $('#leavesTable').DataTable({
            "searching": false,
            "lengthChange": false,
            "language": {
                "emptyTable": "لا توجد طلبات لعرضها حالياً",
                "info": "عرض _START_ إلى _END_ من أصل _TOTAL_",
                "paginate": { "next": "التالي", "previous": "السابق" }
            },
            "dom": 'rtp',
            "pageLength": 10
        });
    });

    function calculateDays() {
        var start = document.getElementById("startDate").value;
        var end = document.getElementById("endDate").value;
        if(start && end) {
            var d1 = new Date(start);
            var d2 = new Date(end);
            var dayDiff = (d2.getTime() - d1.getTime()) / (1000 * 3600 * 24);
            var total = dayDiff + 1;
            document.getElementById("daysCount").value = total > 0 ? total + " أيام" : "تاريخ غير صالح";
        }
    }
</script>
