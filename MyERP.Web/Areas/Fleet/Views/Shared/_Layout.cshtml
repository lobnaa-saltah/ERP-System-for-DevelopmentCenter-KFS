<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@ViewData["Title"] - المنصة الرقمية</title>
    <!-- 1. SEO Meta Tags -->
    <meta name="description" content="المنصة الرقمية الموحدة لمحافظة كفر الشيخ - نظام ERP شامل لإدارة الموارد البشرية، المخازن، الشئون القانونية، والحملة">
    <meta name="keywords" content="ERP, كفر الشيخ, موارد بشرية, مخازن, حكومة الكترونية, تحول رقمي">
    <meta name="author" content="الإدارة العامة لنظم المعلومات والتحول الرقمي">
    <!-- Bootstrap -->
    <link rel="stylesheet" href="~/css/bootstrap/bootstrap.min.css">
    <!-- Font Awesome -->
    <link rel="stylesheet" href="~/css/all.min.css">
    <!-- animate -->
    <link rel="stylesheet" href="~/css/animate/animate.css">
    <!-- Global Css Link -->
    <link rel="stylesheet" href="~/css/global/main.css">
    <!-- Theme style -->
    <link rel="stylesheet" href="~/css/global/adminlte.css">
    <!-- dash-style -->
    <link rel="stylesheet" href="~/css/global/dash-style.css">
    <!-- Modern Luxe Custom Styles -->
    <style>
        .main-sidebar { top: 62px !important; height: calc(100vh - 62px) !important; position: fixed !important; background: #0f172a !important; border-left: 1px solid rgba(255,255,255,0.05); }
        .content-wrapper { margin-top: 0 !important; }
        .sidebar { height: calc(100% - 10px) !important; overflow-y: auto; p-0; }
        .btn-login-style:hover { background: #3b82f6 !important; color: #fff !important; box-shadow: 0 0 15px rgba(59, 130, 246, 0.4); }
        .search-permanent input::placeholder { color: rgba(255,255,255,0.3); }
    </style>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cairo:wght@300;400;500;600;700;800;900&display=swap">
</head>
<body class="hold-transition sidebar-mini layout-fixed" style="margin:0;">
    <!-- Modern Integrated Navbar -->
    <nav class="navbar sticky-top shadow-sm" style="background: #0f172a !important; border-bottom: 1px solid rgba(255,255,255,0.1); font-family: 'Cairo', sans-serif; padding: 0.5rem 0 0.8rem 0; height: 62px; z-index: 1040;">
        <div class="container-fluid px-4 d-flex align-items-center justify-content-between">
            <!-- Right side (RTL): Menu Toggle & Logo -->
            <div class="d-flex align-items-center gap-3">
                <a class="nav-link text-white p-2 hover-bg-white-10 rounded-3" data-widget="pushmenu" href="#" role="button" title="فتح القائمة الجانبية">
                    <i class="fas fa-bars" style="font-size: 1.25rem;"></i>
                </a>
                <div class="navbar-brand d-flex align-items-center ms-2 m-0" style="cursor: default;">
                    <img src="~/imgs/kfslogo.jpg" style="height: 40px; border-radius: 6px; box-shadow: 0 4px 10px rgba(0,0,0,0.3);" alt="KFS Logo">
                    <div class="d-flex flex-column me-3 d-none d-md-flex" style="gap: 0.3rem;">
                        <span style="color: #fff; font-weight: 800; font-size: 1.15rem; line-height: 1;">إدارة المركبات والحملة</span>
                        <small style="color: rgba(255,255,255,0.6); font-size: 0.75rem; letter-spacing: 0.5px;">محافظة كفر الشيخ</small>
                    </div>
                </div>
            </div>
            <!-- Left side: Utilities & Navigation -->
            <div class="d-flex align-items-center gap-2">
                <div class="search-permanent d-none d-lg-block" style="width: 320px;">
                    <div class="input-group overflow-hidden shadow-sm d-flex flex-row-reverse" style="background: rgba(255,255,255,0.05); border-radius: 50px; border: 1px solid rgba(255,255,255,0.1); padding: 2px 15px;">
                        <span class="input-group-text border-0 bg-transparent p-0 d-flex align-items-center"><i class="fas fa-search text-white opacity-40" style="font-size: 0.9rem;"></i></span>
                        <input class="form-control border-0 bg-transparent text-white me-2 text-start" type="search" placeholder="بحث سريع..." style="font-family: 'Cairo', sans-serif; font-size: 0.85rem; height: 34px; box-shadow: none !important; direction: ltr;">
                    </div>
                </div>
                <a class="nav-link text-white opacity-50 hover-opacity-100 p-0 d-none d-sm-block ms-2" data-widget="fullscreen" href="#" role="button" title="تكبير الشاشة"><i class="fas fa-expand-arrows-alt" style="font-size: 1.1rem;"></i></a>
                <a asp-area="" asp-controller="Home" asp-action="Index" class="btn btn-login-style ms-2 d-flex align-items-center gap-2 px-3 py-1.5" style="background: transparent; border: 1px solid #3b82f6; border-radius: 10px; color: #3b82f6; font-size: 0.9rem; font-weight: 700; transition: all 0.3s ease;">
                    <i class="fa-solid fa-house-chimney-window"></i>
                    <span>الرئيسية</span>
                </a>
            </div>
        </div>
    </nav>
    <div class="wrapper">
        <!-- Main Sidebar Container -->
        <aside class="main-sidebar sidebar-dark-primary elevation-4 bg-dark">
            <!-- Sidebar -->
            <div class="sidebar p-0">

                <!-- Sidebar right Menu -->
                <nav class="mt-2">
                    <ul class="nav nav-pills nav-sidebar flex-column" data-widget="treeview" role="menu" data-accordion="false">
                        <nav class="mt-2">
                            <ul class="nav nav-pills nav-sidebar flex-column" data-widget="treeview" role="menu" data-accordion="false">
                                <!-- 1. اللوحة الرئيسية -->
                                <li class="nav-item">
                                    <a asp-area="Fleet" asp-controller="Home" asp-action="Index" class="nav-link active">
                                        <i class="nav-icon fas fa-tachometer-alt"></i>
                                        <p>إحصائيات الحملة</p>
                                    </a>
                                </li>

                                <!-- 2. الأصول والسائقين (التعريفات) -->
                                <li class="nav-item menu-open">
                                    <a href="#" class="nav-link">
                                        <i class="nav-icon fas fa-car"></i>
                                        <p>
                                            أسطول المركبات
                                            <i class="fas fa-angle-left right"></i>
                                        </p>
                                    </a>
                                    <ul class="nav nav-treeview">
                                        <li class="nav-item">
                                            <!-- سجل السيارات -->
                                            <a asp-area="Fleet" asp-controller="Vehicles" asp-action="Index" class="nav-link text-info">
                                                <i class="fas fa-list nav-icon"></i>
                                                <p>سجل المركبات والمعدات</p>
                                            </a>
                                        </li>
                                        <li class="nav-item">
                                            <!-- السائقين والرخص -->
                                            <a asp-area="Fleet" asp-controller="Drivers" asp-action="Index" class="nav-link">
                                                <i class="fas fa-user-friends nav-icon"></i>
                                                <p>السائقين والرخص</p>
                                            </a>
                                        </li>
                                        <li class="nav-item">
                                            <a asp-area="Fleet" asp-controller="Definitions" asp-action="VehicleTypes" class="nav-link">
                                                <i class="fas fa-tags nav-icon"></i>
                                                <p>أنواع وفئات السيارات</p>
                                            </a>
                                        </li>
                                    </ul>
                                </li>

                                <!-- 3. التشغيل والحركة (Operations) -->
                                <li class="nav-item">
                                    <a href="#" class="nav-link">
                                        <i class="nav-icon fas fa-route"></i>
                                        <p>
                                            التشغيل وخطوط السير
                                            <i class="right fas fa-angle-left"></i>
                                        </p>
                                    </a>
                                    <ul class="nav nav-treeview">
                                        <li class="nav-item">
                                            <!-- أمر شغل (يومي) -->
                                            <a asp-area="Fleet" asp-controller="Trips" asp-action="Create" class="nav-link text-success">
                                                <i class="fas fa-file-signature nav-icon"></i>
                                                <p>أمر تشغيل / حركة</p>
                                            </a>
                                        </li>
                                        <li class="nav-item">
                                            <!-- متابعة السيارات بالخارج -->
                                            <a asp-area="Fleet" asp-controller="Trips" asp-action="Active" class="nav-link">
                                                <i class="fas fa-map-marker-alt nav-icon"></i>
                                                <p>متابعة الحركة الحالية</p>
                                            </a>
                                        </li>
                                        <li class="nav-item">
                                            <!-- طلبات الإدارات -->
                                            <a asp-area="Fleet" asp-controller="Requests" asp-action="Index" class="nav-link">
                                                <i class="fas fa-inbox nav-icon"></i>
                                                <p>طلبات السيارات (وارد)</p>
                                            </a>
                                        </li>
                                    </ul>
                                </li>

                                <!-- 4. الوقود والمصروفات (Costs) -->
                                <li class="nav-item">
                                    <a href="#" class="nav-link">
                                        <i class="nav-icon fas fa-gas-pump"></i>
                                        <p>
                                            الوقود والمصروفات
                                            <i class="fas fa-angle-left right"></i>
                                        </p>
                                    </a>
                                    <ul class="nav nav-treeview">
                                        <li class="nav-item">
                                            <a asp-area="Fleet" asp-controller="Fuel" asp-action="Logs" class="nav-link">
                                                <i class="fas fa-oil-can nav-icon"></i>
                                                <p>سجل التزود بالوقود</p>
                                            </a>
                                        </li>
                                        <li class="nav-item">
                                            <a asp-area="Fleet" asp-controller="Expenses" asp-action="Tolls" class="nav-link">
                                                <i class="fas fa-road nav-icon"></i>
                                                <p>الكارتة والطرق</p>
                                            </a>
                                        </li>
                                        <li class="nav-item">
                                            <!-- المخالفات -->
                                            <a asp-area="Fleet" asp-controller="Expenses" asp-action="Fines" class="nav-link">
                                                <i class="fas fa-exclamation-triangle nav-icon text-danger"></i>
                                                <p>المخالفات المرورية</p>
                                            </a>
                                        </li>
                                    </ul>
                                </li>

                                <!-- 5. الصيانة الدورية والورشة (Maintenance) -->
                                <li class="nav-item">
                                    <a href="#" class="nav-link">
                                        <i class="nav-icon fas fa-tools"></i>
                                        <p>
                                            الورشة والصيانة
                                            <i class="fas fa-angle-left right"></i>
                                        </p>
                                    </a>
                                    <ul class="nav nav-treeview">
                                        <li class="nav-item">
                                            <a asp-area="Fleet" asp-controller="Maintenance" asp-action="CreateRequest" class="nav-link">
                                                <i class="fas fa-wrench nav-icon"></i>
                                                <p>طلب إصلاح / صيانة</p>
                                            </a>
                                        </li>
                                        <li class="nav-item">
                                            <a asp-area="Fleet" asp-controller="Maintenance" asp-action="Schedule" class="nav-link">
                                                <i class="fas fa-calendar-check nav-icon"></i>
                                                <p>جدول الصيانة الدورية</p>
                                            </a>
                                        </li>
                                        <li class="nav-item">
                                            <a asp-area="Fleet" asp-controller="Parts" asp-action="Usage" class="nav-link">
                                                <i class="fas fa-cogs nav-icon"></i>
                                                <p>صرف قطع غيار</p>
                                            </a>
                                        </li>
                                    </ul>
                                </li>

                                <!-- 6. الوثائق والتنبيهات (Expiry) -->
                                <li class="nav-header">التراخيص والتنبيهات</li>

                                <li class="nav-item">
                                    <a asp-area="Fleet" asp-controller="Documents" asp-action="Licenses" class="nav-link">
                                        <i class="far fa-id-card nav-icon text-warning"></i>
                                        <p>رخص التسيير</p>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a asp-area="Fleet" asp-controller="Documents" asp-action="Insurance" class="nav-link">
                                        <i class="fas fa-file-medical-alt nav-icon"></i>
                                        <p>وثائق التأمين</p>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a asp-area="Fleet" asp-controller="Documents" asp-action="DriversLicense" class="nav-link">
                                        <i class="fas fa-address-card nav-icon"></i>
                                        <p>رخص القيادة (سائقين)</p>
                                    </a>
                                </li>

                                <!-- 7. التقارير -->
                                <li class="nav-header">تقارير الحملة</li>

                                <li class="nav-item">
                                    <a asp-area="Fleet" asp-controller="Reports" asp-action="CostAnalysis" class="nav-link">
                                        <i class="fas fa-calculator nav-icon"></i>
                                        <p>تحليل تكاليف المركبة</p>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a asp-area="Fleet" asp-controller="Reports" asp-action="History" class="nav-link">
                                        <i class="fas fa-history nav-icon"></i>
                                        <p>أرشيف تحركات سيارة</p>
                                    </a>
                                </li>
                            </ul>
                        </nav>
                        <!-- /  Sidebar right Menu -->
            </div>
            <!-- /.sidebar -->
        </aside>
        <!-- Main Sidebar Container -->

        <div class="content-wrapper">
            @RenderBody()
        </div>
        <!-- Start Footer (Modern Style) -->
        <footer style="background: #0f172a !important; border-top: 1px solid rgba(255,255,255,0.1) !important; padding: 1.5rem 0 !important; font-family: 'Cairo', sans-serif !important; height: auto !important; min-height: 60px !important; display: block !important;">
            <div class="container-fluid text-center">
                <p style="color: #fff !important; margin: 0 !important; font-size: 0.9rem !important; font-weight: 500 !important; opacity: 0.85 !important; line-height: 1.8 !important; padding: 0 1.5rem !important; word-wrap: break-word !important; white-space: normal !important;">
                    حقوق الطبع والنشر &copy; الإدارة العامة لنظم المعلومات والتحول الرقمي <a href="#" style="color: #3b82f6 !important; font-weight: 700 !important; text-decoration: none !important; display: inline-block !important;">إدارة النظم والتطبيقات</a>.
                </p>
            </div>
        </footer>
        <!-- End Footer -->
        <!-- jQuery -->
        <script src="js/jquery/jquery.min.js"></script>
        <!-- Bootstrap -->
        <script src="js/bootstrap/bootstrap.bundle.min.js"></script>
        <!-- Font Awesome  -->
        <script src="js/all.min.js"></script>
        <!-- AdminLTE App -->
        <script src="js/global/adminlte.js"></script>
        <!-- global js -->
        <script src="js/global/main.js"></script>

        <script src="js/animate/wow.min.js"></script>
        <script>
            new WOW().init();
        </script>
        <script>
            $(function () {
                $('.select2').select2()
            });
        </script>
</body>
</html>