@{
    ViewData["Title"] = "الرئيسية";
}

@{
    ViewData["Title"] = "الرئيسية";
}

<!-- Start Modules Grid Section -->
<section class="modules-section">
    <div class="container">
        <!-- Hero Carousel Section -->
        <div class="hero-carousel-wrapper position-relative wow fadeIn mb-5" data-wow-delay="0.1s">
            <div id="kfsCarousel" class="carousel slide carousel-fade shadow-lg overflow-hidden" style="border-radius: 2rem;" data-bs-ride="carousel" data-bs-pause="false">
                <div class="carousel-indicators">
                    <button type="button" data-bs-target="#kfsCarousel" data-bs-slide-to="0" class="active" aria-current="true"></button>
                    <button type="button" data-bs-target="#kfsCarousel" data-bs-slide-to="1"></button>
                    <button type="button" data-bs-target="#kfsCarousel" data-bs-slide-to="2"></button>
                    <button type="button" data-bs-target="#kfsCarousel" data-bs-slide-to="3"></button>
                </div>
                <div class="carousel-inner">
                    <div class="carousel-item active" data-bs-interval="3500">
                        <img src="~/image/slide1.jpg" class="d-block w-100" style="height: 450px; object-fit: cover;" alt="Kafr El-Sheikh 1">
                    </div>
                    <div class="carousel-item" data-bs-interval="3500">
                        <img src="~/image/slide2.jpg" class="d-block w-100" style="height: 450px; object-fit: cover;" alt="Kafr El-Sheikh 2">
                    </div>
                    <div class="carousel-item" data-bs-interval="3500">
                        <img src="~/image/slide3.jpg" class="d-block w-100" style="height: 450px; object-fit: cover;" alt="Kafr El-Sheikh 3">
                    </div>
                    <div class="carousel-item" data-bs-interval="3500">
                        <img src="~/image/slide4.jpg" class="d-block w-100" style="height: 450px; object-fit: cover;" alt="Kafr El-Sheikh 4">
                    </div>
                </div>
                <button class="carousel-control-prev" type="button" data-bs-target="#kfsCarousel" data-bs-slide="prev">
                    <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                </button>
                <button class="carousel-control-next" type="button" data-bs-target="#kfsCarousel" data-bs-slide="next">
                    <span class="carousel-control-next-icon" aria-hidden="true"></span>
                </button>
            </div>

            <!-- Hero Title Overlay -->
            <div class="hero-title-overlay">
                <p class="hero-sub-top">محافظة كفر الشيخ</p>
                <h1 class="hero-main-title">الإدارة العامة لنظم المعلومات والتحول الرقمي</h1>
                <p class="hero-sub-bottom">المنصة الرقمية الموحدة</p>
            </div>

            <!-- Live Date & Time Badge -->
            <div class="live-datetime-badge d-flex align-items-center">
                <i class="fa-regular fa-calendar-days ms-3 text-warning"></i>
                <div class="d-flex flex-column text-end">
                    <span id="liveDate" class="fw-bold m-0 lh-1" style="font-size: 1.1rem;"></span>
                    <span id="liveTime" class="opacity-75 mt-1" style="font-size: 0.9rem;"></span>
                </div>
            </div>
        </div>

        <!-- Section Header -->
        <div class="text-center mb-5">
            <span class="section-tag wow fadeInUp">نظام إدارة موارد المؤسسة</span>
            <h2 class="section-title wow fadeInUp" data-wow-delay="0.2s">بوابة الخدمات والأنظمة</h2>
        </div>

        <div class="row g-4 row-cols-1 row-cols-md-2 row-cols-lg-3 row-cols-xl-4 pb-5">

            <!-- 1. HR Module -->
            <div class="col wow fadeInUp" data-wow-delay="0.1s">
                <a asp-area="HR" asp-controller="Home" asp-action="Index" class="module-card p-0 d-flex flex-column overflow-hidden">
                    <img src="https://images.unsplash.com/photo-1522071820081-009f0129c71c?w=500&q=80" alt="HR" style="width: 100%; height: 160px; object-fit: cover;">
                    <div class="p-4 d-flex flex-column" style="flex: 1;">
                        <div class="card-content">
                            <h3>الموارد البشرية</h3>
                            <p>إدارة بيانات الموظفين، الحضور والانصراف، والرواتب بشكل مؤتمت بالكامل.</p>
                        </div>
                        <div class="enter-badge mt-auto">دخول النظام <i class="fa-solid fa-arrow-left-long me-2"></i></div>
                    </div>
                </a>
            </div>

            <!-- 2. Legal Affairs -->
            <div class="col wow fadeInUp" data-wow-delay="0.2s">
                <a asp-area="Legal" asp-controller="Home" asp-action="Index" class="module-card p-0 d-flex flex-column overflow-hidden">
                    <img src="https://images.unsplash.com/photo-1454165804606-c3d57bc86b40?w=500&q=80" alt="Legal" style="width: 100%; height: 160px; object-fit: cover;">
                    <div class="p-4 d-flex flex-column" style="flex: 1;">
                        <div class="card-content">
                            <h3>الشئون القانونية</h3>
                            <p>متابعة التحقيقات، القضايا، وصياغة العقود والاتفاقيات القانونية.</p>
                        </div>
                        <div class="enter-badge mt-auto">دخول النظام <i class="fa-solid fa-arrow-left-long me-2"></i></div>
                    </div>
                </a>
            </div>

            <!-- 3. Inventory & Procurement -->
            <div class="col wow fadeInUp" data-wow-delay="0.3s">
                <a asp-area="Inventory" asp-controller="Home" asp-action="Index" class="module-card p-0 d-flex flex-column overflow-hidden">
                    <img src="https://images.unsplash.com/photo-1586528116311-ad8dd3c8310d?w=500&q=80" alt="Inventory" style="width: 100%; height: 160px; object-fit: cover;">
                    <div class="p-4 d-flex flex-column" style="flex: 1;">
                        <div class="card-content">
                            <h3>المخازن والمشتريات</h3>
                            <p>نظام ذكي لإدارة الأصناف، الجرد الدوري، وعمليات التوريد والشراء.</p>
                        </div>
                        <div class="enter-badge mt-auto">دخول النظام <i class="fa-solid fa-arrow-left-long me-2"></i></div>
                    </div>
                </a>
            </div>

            <!-- 4. Accounting & Finance -->
            <div class="col wow fadeInUp" data-wow-delay="0.4s">
                <a asp-area="Accounting" asp-controller="Home" asp-action="Index" class="module-card p-0 d-flex flex-column overflow-hidden">
                    <img src="https://images.unsplash.com/photo-1554224155-8d04cb21cd6c?w=500&q=80" alt="Accounting" style="width: 100%; height: 160px; object-fit: cover;">
                    <div class="p-4 d-flex flex-column" style="flex: 1;">
                        <div class="card-content">
                            <h3>الحسابات والمالية</h3>
                            <p>إدارة الموازنة العامة، القيود اليومية، وإصدار التقارير المالية التفصيلية.</p>
                        </div>
                        <div class="enter-badge mt-auto">دخول النظام <i class="fa-solid fa-arrow-left-long me-2"></i></div>
                    </div>
                </a>
            </div>

            <!-- 5. Fleet Logistics -->
            <div class="col wow fadeInUp" data-wow-delay="0.5s">
                <a asp-area="Fleet" asp-controller="Home" asp-action="Index" class="module-card p-0 d-flex flex-column overflow-hidden">
                    <img src="https://images.unsplash.com/photo-1580674285054-bed31e145f59?w=500&q=80" alt="Fleet" style="width: 100%; height: 160px; object-fit: cover;">
                    <div class="p-4 d-flex flex-column" style="flex: 1;">
                        <div class="card-content">
                            <h3>الحملة (Logistics)</h3>
                            <p>إدارة حركة المركبات، السائقين، واستهلاك الوقود والصيانة الوقائية.</p>
                        </div>
                        <div class="enter-badge mt-auto">دخول النظام <i class="fa-solid fa-arrow-left-long me-2"></i></div>
                    </div>
                </a>
            </div>

            <!-- 6. Project Planning -->
            <div class="col wow fadeInUp" data-wow-delay="0.6s">
                <a asp-area="Projects" asp-controller="Home" asp-action="Index" class="module-card p-0 d-flex flex-column overflow-hidden">
                    <img src="https://images.unsplash.com/photo-1503387762-592deb58ef4e?w=500&q=80" alt="Projects" style="width: 100%; height: 160px; object-fit: cover;">
                    <div class="p-4 d-flex flex-column" style="flex: 1;">
                        <div class="card-content">
                            <h3>التخطيط والمشاريع</h3>
                            <p>متابعة الخطة الاستثمارية للمحافظة وقياس مؤشرات الأداء التنفيذية.</p>
                        </div>
                        <div class="enter-badge mt-auto">دخول النظام <i class="fa-solid fa-arrow-left-long me-2"></i></div>
                    </div>
                </a>
            </div>

            <!-- 7. Sustainable Education -->
            <div class="col wow fadeInUp" data-wow-delay="0.7s">
                <a asp-area="Education" asp-controller="Home" asp-action="Index" class="module-card p-0 d-flex flex-column overflow-hidden">
                    <img src="https://images.unsplash.com/photo-1497633762265-9d179a990aa6?w=500&q=80" alt="Education" style="width: 100%; height: 160px; object-fit: cover;">
                    <div class="p-4 d-flex flex-column" style="flex: 1;">
                        <div class="card-content">
                            <h3>مركز استدامة</h3>
                            <p>منصة التدريب والتعلم المستمر، إدارة الكورسات والمحتوى التدريبي.</p>
                        </div>
                        <div class="enter-badge mt-auto">دخول النظام <i class="fa-solid fa-arrow-left-long me-2"></i></div>
                    </div>
                </a>
            </div>

            <!-- 8. Control Center (Admin) -->
            <div class="col wow fadeInUp" data-wow-delay="0.8s">
                <a asp-area="Admin" asp-controller="Home" asp-action="Index" class="module-card p-0 d-flex flex-column overflow-hidden">
                    <img src="https://images.unsplash.com/photo-1550751827-4bd374c3f58b?w=500&q=80" alt="Admin" style="width: 100%; height: 160px; object-fit: cover;">
                    <div class="p-4 d-flex flex-column" style="flex: 1;">
                        <div class="card-content">
                            <h3>الإدارة المركزية</h3>
                            <p>إدارة المستخدمين، الصلاحيات، وإعدادات النظام العامة.</p>
                        </div>
                        <div class="enter-badge mt-auto">دخول النظام <i class="fa-solid fa-arrow-left-long me-2"></i></div>
                    </div>
                </a>
            </div>
        </div>
    </div>
</section>
<!-- End Modules -->

@section Scripts {
    <script>
        function updateDateTime() {
            const now = new Date();
            const dateOptions = { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' };
            const timeOptions = { hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: true };
            
            document.getElementById('liveDate').textContent = now.toLocaleDateString('ar-EG', dateOptions);
            document.getElementById('liveTime').textContent = now.toLocaleTimeString('ar-EG', timeOptions);
        }
        
        // Update immediately
        updateDateTime();
        // Update every second for a live clock effect
        setInterval(updateDateTime, 1000);
    </script>
}